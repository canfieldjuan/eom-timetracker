[Unit]
Description=Run the EOM Tracker Atlas-linkage audit hourly
# This is a user timer. Before enabling it on an unattended host, enable the
# monitor user's manager to survive logout:
#   loginctl enable-linger <monitor-user>

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
